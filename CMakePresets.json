{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "description": "基础配置，供其他预设继承",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "17",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_CXX_EXTENSIONS": "OFF",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "gcc-debug",
            "displayName": "GCC Debug",
            "description": "GCC 编译器 Debug 构建",
            "inherits": [
                "base"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_CXX_FLAGS_DEBUG": "-g -O0 -fno-omit-frame-pointer"
            }
        },
        {
            "name": "gcc-release",
            "displayName": "GCC Release",
            "description": "GCC 编译器 Release 构建",
            "inherits": [
                "base"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -flto"
            }
        },
        {
            "name": "clang-debug",
            "displayName": "Clang Debug",
            "description": "Clang 编译器 Debug 构建",
            "inherits": [
                "base"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CMAKE_CXX_FLAGS_DEBUG": "/Zi /Od /Oy-"
            }
        },
        {
            "name": "clang-release",
            "displayName": "Clang Release",
            "description": "Clang 编译器 Release 构建",
            "inherits": [
                "base"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CMAKE_CXX_FLAGS_RELEASE": "/O2 /DNDEBUG /GL",
                "CMAKE_EXE_LINKER_FLAGS_RELEASE": "/LTCG",
                "CMAKE_SHARED_LINKER_FLAGS_RELEASE": "/LTCG"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "gcc-debug",
            "configurePreset": "gcc-debug",
            "displayName": "构建 GCC Debug"
        },
        {
            "name": "gcc-release",
            "configurePreset": "gcc-release",
            "displayName": "构建 GCC Release"
        },
        {
            "name": "clang-debug",
            "configurePreset": "clang-debug",
            "displayName": "构建 Clang Debug"
        },
        {
            "name": "clang-release",
            "configurePreset": "clang-release",
            "displayName": "构建 Clang Release"
        }
    ],
    "testPresets": [
        {
            "name": "gcc-debug",
            "configurePreset": "gcc-debug",
            "displayName": "测试 GCC Debug",
            "output": {
                "outputOnFailure": true,
                "verbosity": "default"
            }
        },
        {
            "name": "clang-debug",
            "configurePreset": "clang-debug",
            "displayName": "测试 Clang Debug",
            "output": {
                "outputOnFailure": true,
                "verbosity": "default"
            }
        }
    ]
}
